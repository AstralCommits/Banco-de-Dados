# Copie para backup.env e ajuste. NAO versione o backup.env (contem senha).
#   cp backup.env.example backup.env && chmod 600 backup.env
#
# O formato ": ${VAR:=valor}" permite que uma variavel de ambiente
# definida na chamada (ex.: RETENTION_DAYS=3 ./backup_database.sh) tenha prioridade.

: "${DB_HOST:=127.0.0.1}"
: "${DB_PORT:=3306}"
: "${DB_NAME:=confeccoes}"
: "${DB_USER:=backup_user}"
: "${DB_PASS:=troque_esta_senha}"

# Onde os .sql.gz serao gravados
: "${BACKUP_DIR:=/var/backups/confeccoes}"

# Quantos dias de backup manter
: "${RETENTION_DAYS:=7}"
